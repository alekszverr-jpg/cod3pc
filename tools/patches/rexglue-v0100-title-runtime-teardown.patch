+
+bool ReXApp::RequestTitleRuntimeRestart() {
+  if (runtime_ || shutting_down_.load(std::memory_order_acquire)) return false;
+  restart_title_requested_.store(true, std::memory_order_release);
+  return true;
+}
+
+bool ReXApp::ShutdownTitleRuntime() {
+  bool released = false;
+  const bool called = app_context().CallInUIThreadSynchronous([this, &released]() {
+    if (shutting_down_.load(std::memory_order_acquire) || !runtime_) return;
+    auto* kernel = runtime_->kernel_state();
+    // These checks supplement the caller's full guest/audio/GPU/dispatch
+    // barriers; they are not a substitute for those native-exit observations.
+    if (!kernel) return;
+    const auto guests = kernel->WaitForTitleThreadExit(0);
+    if (!guests.sealed || !guests.creation_complete || guests.pending ||
+        kernel->PendingExitedThreadObjects() || !kernel->QuiesceDispatchForTitleShutdown(0)) {
+      REXLOG_ERROR("TITLE_RUNTIME_RELEASE rejected: unsealed creation or exit references remain");
+      return;
+    }
+    ReleaseRuntimePresentation();
+    runtime_.reset();
+    released = Runtime::instance() == nullptr && system::KernelState::shared() == nullptr;
+    REXLOG_INFO("TITLE_RUNTIME_RELEASE globals_cleared={} window_alive={}", released, window_ != nullptr);
+  });
+  return called && released;
+}
+
+void ReXApp::OnDestroy() {
+  // Notify subclass before cleanup. Runtime may already have been released by
+  // an explicitly drained title; presentation release is idempotent.
+  OnShutdown();
+  ReleaseRuntimePresentation();
   if (module_thread_.joinable()) {
     module_thread_.join();
   }
