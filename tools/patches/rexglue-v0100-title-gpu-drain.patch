+bool CommandProcessor::RequestTitleShutdown(uint32_t timeout_ms) {
+  title_work_gate_.Seal();
+  if (!title_work_gate_.WaitForIdle(std::chrono::milliseconds(timeout_ms))) {
+    REXGPU_WARN("TITLE_GPU_COMMAND_STOP_REJECTED reason=work_admission_timeout");
+    return false;
+  }
+  if (paused_) {
+    REXGPU_WARN("TITLE_GPU_COMMAND_STOP_REJECTED reason=debugger_paused");
+    return false;
+  }
+  title_shutdown_requested_.store(true, std::memory_order_release);
+  worker_running_.store(false, std::memory_order_release);
+  write_ptr_index_event_->Set();
+  return true;
+}
+
+bool CommandProcessor::WaitForTitleShutdown(uint32_t timeout_ms) {
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+  if (!title_work_gate_.WaitForIdle(std::chrono::milliseconds(timeout_ms))) return false;
+  const auto now = std::chrono::steady_clock::now();
+  const auto remaining = now < deadline
+      ? std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now)
+      : std::chrono::milliseconds(0);
+  auto* native = worker_thread_ ? worker_thread_->thread() : nullptr;
+  const bool exited = native && rex::thread::Wait(native, false, remaining) ==
+                                     rex::thread::WaitResult::kSuccess;
+  const bool idle = title_queue_idle_.load(std::memory_order_acquire);
+  REXGPU_INFO("TITLE_GPU_COMMAND_DRAIN exited={} queue_idle={} native={}",
+      exited, idle, native ? native->system_id() : 0);
+  return exited && idle;
+}
