 void CommandProcessor::CallInThread(std::function<void()> fn) {
+  (void)TryCallInThread(std::move(fn));
+}
+
+bool CommandProcessor::TryCallInThread(std::function<void()> fn) {
+  if (!title_work_gate_.TryEnter()) {
+    REXGPU_WARN("GPU title work rejected after shutdown seal");
+    return false;
+  }
+  struct WorkLease {
+    system::TitleThreadGate& gate;
+    ~WorkLease() { gate.Leave(); }
+  } lease{title_work_gate_};
+  std::unique_lock lock(pending_fns_mutex_);
   if (pending_fns_.empty() && system::XThread::IsInThread(worker_thread_.get())) {
+    lock.unlock();
     fn();
   } else {
     pending_fns_.push(std::move(fn));
+  }
+  return true;
+}
+
+bool CommandProcessor::HasPendingFunctions() const {
+  std::lock_guard lock(pending_fns_mutex_);
+  return !pending_fns_.empty();
+}
+
+void CommandProcessor::DrainPendingFunctions() {
+  for (;;) {
+    std::function<void()> fn;
+    {
+      std::lock_guard lock(pending_fns_mutex_);
+      if (pending_fns_.empty()) return;
+      fn = std::move(pending_fns_.front());
+      pending_fns_.pop();
+    }
+    fn();
   }
 }
 
