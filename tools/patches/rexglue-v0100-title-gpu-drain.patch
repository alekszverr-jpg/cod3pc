+
+bool GraphicsSystem::QuiesceForTitleShutdown(uint32_t timeout_ms) {
+  using clock = std::chrono::steady_clock;
+  const auto deadline = clock::now() + std::chrono::milliseconds(timeout_ms);
+  const auto remaining = [&]() -> uint32_t {
+    const auto now = clock::now();
+    return now < deadline ? static_cast<uint32_t>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count()) : 0;
+  };
+  title_interrupt_gate_.Seal();
+  vsync_worker_running_.store(false, std::memory_order_release);
+  const bool commands_requested = command_processor_ &&
+      command_processor_->RequestTitleShutdown(remaining());
+  auto* native = vsync_worker_thread_ ? vsync_worker_thread_->thread() : nullptr;
+  const bool vsync_exited = !vsync_worker_thread_ || (native &&
+      rex::thread::Wait(native, false, std::chrono::milliseconds(remaining())) ==
+          rex::thread::WaitResult::kSuccess);
+  const bool commands_exited = commands_requested &&
+      command_processor_->WaitForTitleShutdown(remaining());
+  const bool callbacks_idle = title_interrupt_gate_.WaitForIdle(std::chrono::milliseconds(0));
+  REXGPU_INFO("TITLE_GPU_DRAIN vsync_exited={} commands_exited={} callbacks_idle={} native={}",
+      vsync_exited, commands_exited, callbacks_idle, native ? native->system_id() : 0);
+  // Keep provider/presenter, kernel and memory alive even after a timeout.
+  return vsync_exited && commands_exited && callbacks_idle;
 }
 
