+// not fiber-local storage: switching fibers must not retire the live callback.
+thread_local std::unique_ptr<ThreadStartData> current_start_data_;
 DWORD WINAPI ThreadStartRoutine(LPVOID parameter) {
   current_thread_ = std::make_unique<Win32Thread>(::GetCurrentThread());
 
-  auto start_data = reinterpret_cast<ThreadStartData*>(parameter);
-  start_data->start_routine();
-  delete start_data;
+  current_start_data_.reset(reinterpret_cast<ThreadStartData*>(parameter));
+  current_start_data_->start_routine();
+  current_start_data_.reset();
   return 0;
 }
 
