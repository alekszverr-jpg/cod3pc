+
+namespace {
+std::array<std::atomic<bool>, kMaxGuestUsers> keyboard_mouse{true, true, true, true};
+std::mutex activity_mutex;
+std::map<std::pair<uint32_t, DeviceId>, X_INPUT_GAMEPAD> previous_activity;
+}
+void ResetInputActivity() {
+  std::lock_guard lock(activity_mutex);
+  previous_activity.clear();
+  for (auto& active : keyboard_mouse) active.store(true);
+}
+void KeyboardMouseUsed(uint32_t user_index) {
+  if (user_index < kMaxGuestUsers) keyboard_mouse[user_index].store(true);
+}
+bool IsKeyboardMouseActive(uint32_t user_index) {
+  return user_index < kMaxGuestUsers && keyboard_mouse[user_index].load();
+}
+void ObserveInputActivity(uint32_t user_index, DeviceId id, bool synthetic,
+                          const X_INPUT_GAMEPAD& state) {
+  if (synthetic || user_index >= kMaxGuestUsers || id == DeviceId::kInvalid) return;
+  std::lock_guard lock(activity_mutex);
+  auto& previous = previous_activity[{user_index, id}];
+  auto axis = [](int16_t a, int16_t b) {
+    return std::abs(int(a)) >= kThumbDeadzone && std::abs(int(a) - int(b)) >= 512;
+  };
+  auto trigger = [](uint8_t a, uint8_t b) {
+    return a >= kTriggerThreshold && (b < kTriggerThreshold || std::abs(int(a)-int(b)) >= 2);
+  };
+  const bool changed = uint16_t(state.buttons) != uint16_t(previous.buttons) ||
+      trigger(state.left_trigger, previous.left_trigger) ||
+      trigger(state.right_trigger, previous.right_trigger) ||
+      axis(state.thumb_lx, previous.thumb_lx) || axis(state.thumb_ly, previous.thumb_ly) ||
+      axis(state.thumb_rx, previous.thumb_rx) || axis(state.thumb_ry, previous.thumb_ry);
+  if (!IsNeutral(state) && changed) keyboard_mouse[user_index].store(false);
+  // Keep a stable baseline so tiny stick changes accumulate rather than
+  // continuously stealing the device from a mouse; neutral drift never wins.
+  if (changed || IsNeutral(state)) previous = state;
+}
 
