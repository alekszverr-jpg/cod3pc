+bool KernelState::QuiesceDispatchForTitleShutdown(uint32_t timeout_ms) {
+  if (!title_thread_gate_.sealed()) {
+    REXSYS_ERROR("TITLE_DISPATCH_DRAIN complete=false reason=guest_creation_not_sealed");
+    return false;
+  }
+  std::list<std::function<void()>> retired;
+  object_ref<XHostThread> worker;
+  {
+    // This same lock guards admission, dequeue and the stop decision. A callback
+    // already dequeued may finish while Runtime/modules/memory remain alive.
+    auto global_lock = global_critical_region_.Acquire();
+    dispatch_thread_running_ = false;
+    worker = dispatch_thread_;
+    retired.splice(retired.end(), dispatch_queue_);
+    dispatch_cond_.notify_all();
+  }
+  const auto retired_count = retired.size();
+  // Destroy queued captures outside the kernel lock and before DLL unloading.
+  // The old guest has exited; cancelled work is not reported as completed I/O.
+  retired.clear();
+  auto* native = worker ? worker->thread() : nullptr;
+  const bool exited = !worker || (native &&
+      rex::thread::Wait(native, false, std::chrono::milliseconds(timeout_ms)) ==
+          rex::thread::WaitResult::kSuccess);
+  REXSYS_INFO("TITLE_DISPATCH_DRAIN native_exited={} retired={} complete={}",
+              exited, retired_count, exited);
+  return exited;
+}
