 namespace rex::system {
 
+namespace {
+// Kept outside KernelState to preserve the pinned class member layout. Entries
+// are explicitly drained while their KernelState/memory are still alive.
+std::mutex exited_threads_mutex;
+std::unordered_map<KernelState*, std::vector<object_ref<XThread>>> exited_threads;
+}
+
+void KernelState::RetainThreadThroughNativeExit(object_ref<XThread> thread) {
+  std::lock_guard lock(exited_threads_mutex);
+  exited_threads[this].push_back(std::move(thread));
+}
+
+size_t KernelState::ReapExitedThreadObjects() {
+  std::vector<object_ref<XThread>> ready;
+  {
+    std::lock_guard lock(exited_threads_mutex);
+    const auto found = exited_threads.find(this);
+    if (found == exited_threads.end()) return 0;
+    auto& pending = found->second;
+    for (auto it = pending.begin(); it != pending.end();) {
+      auto* native = (*it)->thread();
+      if (native && rex::thread::Wait(native, false, std::chrono::milliseconds(0)) ==
+                        rex::thread::WaitResult::kSuccess) {
+        ready.push_back(std::move(*it));
+        it = pending.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    if (pending.empty()) exited_threads.erase(found);
+  }
+  const auto count = ready.size();
+  // XThread destructors unregister and free contexts. Never hold our registry
+  // mutex across those callbacks or the kernel global critical region.
+  ready.clear();
+  return count;
+}
+
+size_t KernelState::PendingExitedThreadObjects() {
+  std::lock_guard lock(exited_threads_mutex);
+  const auto found = exited_threads.find(this);
+  return found == exited_threads.end() ? 0 : found->second.size();
+}
+
