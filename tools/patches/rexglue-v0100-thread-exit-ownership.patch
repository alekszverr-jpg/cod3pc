   // Safe to reset now: Runtime::Shutdown() has already stopped graphics,
   // audio, and input before destroying KernelState.
+  // Normal shutdown may have just signaled the dispatch guest object while
+  // its native epilogue is still running. Require actual exit before releasing
+  // the transferred self-references and freeing the old object table/memory.
+  const auto exit_deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  for (;;) {
+    ReapExitedThreadObjects();
+    if (!PendingExitedThreadObjects()) break;
+    if (std::chrono::steady_clock::now() >= exit_deadline) {
+      REX_FATAL("KernelState destruction blocked: native thread exit references remain");
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
   object_table_.Reset();
 
