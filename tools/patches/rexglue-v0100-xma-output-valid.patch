# XMA output-valid portion adapted from SirCarls/cod3_REcomp_ patch 0061.
# Reference main: 6ae4839cc780664fd9a1b039173083f0dd4fc9c1.
# MIT notice: licenses/SirCarls-COD_3_WAW-MIT.txt; upstream SDK BSD notices retained.
# Callback pacing is intentionally outside this patch.
diff --git a/include/rex/audio/xma/context.h b/include/rex/audio/xma/context.h
--- a/include/rex/audio/xma/context.h
+++ b/include/rex/audio/xma/context.h
@@ -294,6 +294,7 @@
 
   // Output buffer tracking
   int32_t remaining_subframe_blocks_in_output_buffer_ = 0;
+  bool wrote_output_ = false;
   uint8_t current_frame_remaining_subframes_ = 0;
 
   // Loop subframe precision state
diff --git a/src/audio/xma_context.cpp b/src/audio/xma_context.cpp
--- a/src/audio/xma_context.cpp
+++ b/src/audio/xma_context.cpp
@@ -109,6 +109,7 @@
   }
 
   memory::RingBuffer output_rb = PrepareOutputRingBuffer(&data);
+  wrote_output_ = false;
 
   // Consume-only context: no input, just drain remaining subframes.
   if (data.IsConsumeOnlyContext()) {
@@ -117,6 +118,9 @@
     }
     Consume(&output_rb, &data);
     data.output_buffer_write_offset = output_rb.write_offset() / kOutputBytesPerBlock;
+    if (wrote_output_ && output_rb.empty()) {
+      data.output_buffer_valid = 0;
+    }
     StoreContextMerged(data, initial_data, context_ptr);
     return true;
   }
@@ -143,7 +147,9 @@
 
   data.output_buffer_write_offset = output_rb.write_offset() / kOutputBytesPerBlock;
 
-  if (output_rb.empty()) {
+  // Equal offsets mean full only when this pass actually wrote PCM.
+  // An exhausted input must not expose the previous ring contents as new audio.
+  if (wrote_output_ && output_rb.empty()) {
     data.output_buffer_valid = 0;
   }
 
@@ -459,6 +465,9 @@
 
   output_rb->Write(raw_frame_.data() + (kOutputBytesPerBlock * raw_frame_read_offset),
                    subframes_to_write * kOutputBytesPerBlock);
+  if (subframes_to_write > 0) {
+    wrote_output_ = true;
+  }
 
   const int8_t headroom = (current_frame_remaining_subframes_ - subframes_to_write == 0)
                               ? data->output_buffer_padding
