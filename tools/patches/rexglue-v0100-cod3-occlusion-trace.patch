+bool D3D12CommandProcessor::CollectOcclusionCounterSegments() {
+  if (occlusion_counter_pending_.empty()) return true;
+  uint64_t submission = occlusion_counter_pending_.back().submission;
+  CheckSubmissionFence(submission);
+  if (submission_completed_ < submission || !occlusion_query_readback_mapping_) {
+    REXLOG_ERROR("COD3_OCCLUSION_COUNTER fence incomplete submission={}", submission);
+    return false;
+  }
+  for (const auto& segment : occlusion_counter_pending_) {
+    occlusion_counter_samples_ += occlusion_query_readback_mapping_[segment.host_index];
+  }
+  occlusion_counter_pending_.clear();
+  return true;
+}
+
+bool D3D12CommandProcessor::WriteOcclusionCounterSnapshot(uint32_t address) {
+  auto* counts = memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(address);
+  if (!counts) return false;
+  // Closing the current submission resolves its segment, even if the original
+  // game's interval crosses command-list or frame boundaries.
+  if (submission_open_ && !EndSubmission(false)) return false;
+  if (!CollectOcclusionCounterSegments()) return false;
+  occlusion_counter_started_ = true;
+  uint32_t samples = uint32_t(NormalizeOcclusionSamples(occlusion_counter_samples_));
+  // Preserve the original LE counter ABI and unsigned 32-bit wrap semantics;
+  // clamping a cumulative counter would break guest end-minus-begin queries.
+  std::memset(counts, 0, sizeof(*counts));
+  counts->Total_A = samples;
+  counts->ZPass_A = samples;
+  if (REXCVAR_GET(cod3_occlusion_trace)) {
+    static uint32_t trace_count = 0;
+    if (trace_count++ < 128) {
+      REXLOG_INFO("COD3_OCCLUSION_COUNTER address={:08X} samples={} raw_samples={}",
+                  address, samples, occlusion_counter_samples_);
+    }
+  }
+  return true;
 }
 
