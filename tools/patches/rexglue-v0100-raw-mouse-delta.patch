 namespace rex::input::mnk {
+namespace {
+std::mutex raw_mouse_mutex;
+bool raw_mouse_enabled = false;
+bool raw_mouse_stick = false;
+float raw_mouse_dx = 0, raw_mouse_dy = 0;
+bool RawMouseRequested() {
+  std::lock_guard lock(raw_mouse_mutex);
+  return raw_mouse_enabled;
+}
+}
+void SetRawMouseLook(bool enabled, bool emulate_stick) {
+  std::lock_guard lock(raw_mouse_mutex);
+  if (raw_mouse_enabled == enabled && raw_mouse_stick == emulate_stick) return;
+  raw_mouse_enabled = enabled;
+  raw_mouse_stick = emulate_stick;
+  raw_mouse_dx = raw_mouse_dy = 0;
+}
+void ClearRawMouseDelta() {
+  std::lock_guard lock(raw_mouse_mutex);
+  raw_mouse_dx = raw_mouse_dy = 0;
+}
+void TakeRawMouseDelta(float& dx, float& dy) {
+  std::lock_guard lock(raw_mouse_mutex);
+  dx = raw_mouse_dx; dy = raw_mouse_dy;
+  raw_mouse_dx = raw_mouse_dy = 0;
+}
+
 
