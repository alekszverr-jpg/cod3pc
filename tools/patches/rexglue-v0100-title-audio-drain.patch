+bool AudioSystem::QuiesceForTitleShutdown(uint32_t timeout_ms) {
+  using clock = std::chrono::steady_clock;
+  const auto deadline = clock::now() + std::chrono::milliseconds(timeout_ms);
+  const auto remaining = [&]() -> uint32_t {
+    const auto now = clock::now();
+    return now < deadline ? static_cast<uint32_t>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count()) : 0;
+  };
+  // Seal callback admission, then request both workers stop. No locks are held
+  // while waiting, and no worker/guest contexts are freed on timeout.
+  title_callback_gate_.Seal();
+  worker_running_.store(false, std::memory_order_release);
+  shutdown_event_->Set();
+  resume_event_->Set(); // Also wake a worker paused on its resume event.
+  if (xma_decoder_) xma_decoder_->RequestTitleShutdown();
+  auto* native = worker_thread_ ? worker_thread_->thread() : nullptr;
+  const bool audio_exited = !worker_thread_ || (native &&
+      rex::thread::Wait(native, false, std::chrono::milliseconds(remaining())) ==
+          rex::thread::WaitResult::kSuccess);
+  const bool xma_exited = !xma_decoder_ || xma_decoder_->WaitForTitleShutdown(remaining());
+  const bool callbacks_idle = title_callback_gate_.WaitForIdle(std::chrono::milliseconds(0));
+  REXAPU_INFO("TITLE_AUDIO_DRAIN audio_exited={} xma_exited={} callbacks_idle={} native={}",
+      audio_exited, xma_exited, callbacks_idle, native ? native->system_id() : 0);
+  if (!audio_exited || !xma_exited || !callbacks_idle) return false;
+
+  // DestroyDriver closes the SDL stream/device, synchronizing its host callback
+  // before releasing host frame queues. Keep wrapped callback arguments and XMA
+  // guest context allocations until the later, fully gated Runtime teardown.
+  size_t drivers = 0;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    for (auto& client : clients_) {
+      if (client.in_use && client.driver) {
+        DestroyDriver(client.driver);
+        client.driver = nullptr;
+        ++drivers;
+      }
+    }
+  }
+  REXAPU_INFO("TITLE_AUDIO_DEVICES_CLOSED drivers={}", drivers);
+  return true;
+}
