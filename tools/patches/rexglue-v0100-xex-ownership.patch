+    const auto resolved = NormalizeGuestPath(requested->absolute_path());
+    for (const auto& info : recompiled_modules_) {
+      auto registered = file_system()->ResolvePath("game:\\" + info.guest_path);
+      if (registered && NormalizeGuestPath(registered->absolute_path()) == resolved)
+        return info;
+    }
+  }
   return std::nullopt;
