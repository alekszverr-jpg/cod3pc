+  // UserModule stores the resolved device path, while the manifest records
+  // paths relative to game:. Compare actual VFS identities for unload lookups;
+  // do not match only a basename or strip arbitrary device prefixes.
+  auto requested = file_system()->ResolvePath(guest_path);
