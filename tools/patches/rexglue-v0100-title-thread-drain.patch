+void KernelState::SealTitleThreadCreation() {
+  title_thread_gate_.Seal();
+  auto global_lock = global_critical_region_.Acquire();
+  if (title_drain_active_) return;
+  title_drain_active_ = true;
+  for (const auto& [id, thread] : threads_by_id_) {
+    if (thread->is_guest_thread()) title_drain_threads_.push_back(retain_object(thread));
+  }
+  // Do not terminate anyone here: the original LaunchTitle still needs to
+  // store its launch path/flags before calling TerminateTitle itself.
+}
+
+KernelState::TitleThreadDrainResult KernelState::WaitForTitleThreadExit(uint32_t timeout_ms) {
+  using clock = std::chrono::steady_clock;
+  const auto deadline = clock::now() + std::chrono::milliseconds(timeout_ms);
+  TitleThreadDrainResult result;
+  result.sealed = title_thread_gate_.sealed();
+  if (!result.sealed) return result;
+  // No kernel/global lock while a creator finishes its native Create/Resume.
+  result.creation_complete = title_thread_gate_.WaitForIdle(std::chrono::milliseconds(timeout_ms));
+  std::vector<object_ref<XThread>> threads;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    threads = title_drain_threads_;
+  }
+  result.tracked = threads.size();
+  // Don't read a creator's thread_ until the creation lease is released.
+  if (!result.creation_complete) {
+    result.pending = result.tracked;
+    return result;
+  }
+  for (;;) {
+    result.pending = 0;
+    for (const auto& thread : threads) {
+      auto* native = thread->thread();
+      if (native && rex::thread::Wait(native, false, std::chrono::milliseconds(0)) !=
+                        rex::thread::WaitResult::kSuccess) {
+        ++result.pending;
+      }
+    }
+    if (!result.pending || clock::now() >= deadline) return result;
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+}
+
