new file mode 100644
--- /dev/null
+++ b/include/rex/system/title_thread_gate.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <mutex>
+
+namespace rex::system {
+// A Runtime owns one gate. Sealing is permanent; a new Runtime gets a new gate.
+// A creation lease covers allocation, native-thread creation and initial resume.
+class TitleThreadGate {
+ public:
+  bool TryEnter() {
+    std::lock_guard lock(mutex_);
+    if (sealed_) return false;
+    ++creating_;
+    return true;
+  }
+  void Leave() {
+    std::lock_guard lock(mutex_);
+    --creating_;
+    if (!creating_) idle_.notify_all();
+  }
+  void Seal() {
+    std::lock_guard lock(mutex_);
+    sealed_ = true;
+  }
+  bool sealed() const {
+    std::lock_guard lock(mutex_);
+    return sealed_;
+  }
+  bool WaitForIdle(std::chrono::milliseconds timeout) {
+    std::unique_lock lock(mutex_);
+    return idle_.wait_for(lock, timeout, [this] { return !creating_; });
+  }
+ private:
+  mutable std::mutex mutex_;
+  std::condition_variable idle_;
+  size_t creating_ = 0;
+  bool sealed_ = false;
+};
+}  // namespace rex::system
