   auto global_lock = global_critical_region_.Acquire();
   threads_by_id_[thread->thread_id()] = thread;
+  // Restore registers after entering its creation lease. Retain late
+  // registrations too, even if TerminateTitle already cleared the map.
+  if (title_drain_active_ && thread->is_guest_thread()) {
+    const bool retained = std::any_of(title_drain_threads_.begin(), title_drain_threads_.end(),
+        [thread](const auto& item) { return item.get() == thread; });
+    if (!retained) title_drain_threads_.push_back(retain_object(thread));
+  }
 
   // Thread count is now managed via thread-process linking in
   // XThread::InitializeGuestObject and XThread::Exit.
